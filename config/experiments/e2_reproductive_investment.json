{
  "name": "e2_reproductive_investment",
  "baseConfig": "../default.json",
  "seeds": 10,
  "seedStart": 1000,
  "sampleInterval": 250,
  "description": "Maturity age fixed early (30-40 ticks) vs fixed late (250-300 ticks), plus a mixed population where both founder types compete and maturity can evolve.",
  "hypothesis": "Under resource limitation, does early reproduction or delayed maturity yield larger, more persistent populations \u2014 and which way does maturity evolve when both strategies compete?",
  "ticks": 15000,
  "conditions": [
    {
      "name": "early_fixed",
      "overrides": {
        "population.initialTraits": {
          "maturity": [
            30,
            40
          ]
        },
        "population.lockedGenes": [
          "maturity"
        ]
      }
    },
    {
      "name": "late_fixed",
      "overrides": {
        "population.initialTraits": {
          "maturity": [
            250,
            300
          ]
        },
        "population.lockedGenes": [
          "maturity"
        ]
      }
    },
    {
      "name": "mixed_evolving",
      "overrides": {
        "population.groups": [
          {
            "name": "early",
            "fraction": 0.5,
            "traits": {
              "maturity": [
                30,
                40
              ]
            }
          },
          {
            "name": "late",
            "fraction": 0.5,
            "traits": {
              "maturity": [
                250,
                300
              ]
            }
          }
        ]
      }
    }
  ]
}